# Runtime
APP_ENV=production
APP_VERSION=dev
DATABASE_URL=postgresql+psycopg://sibyl:change-me@db:5432/sibyl
INITIAL_BANKROLL_USD=300
SCAN_INTERVAL_SECONDS=3600
WATCH_INTERVAL_SECONDS=5
ACTIVITY_LOOKBACK_SECONDS=120
ACTIVITY_FETCH_LIMIT=500
CANDIDATE_LIMIT=20
TRACKED_WALLET_LIMIT=3
MARK_INTERVAL_SECONDS=30
RISK_MAX_SIGNAL_AGE_SECONDS=30

# Optional GPT-5.6 advisory layer (never authorizes orders)
AI_ANALYSIS_ENABLED=false
AI_ANALYSIS_INTERVAL_SECONDS=21600
OPENAI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
ADMIN_TOKEN=replace-with-at-least-32-random-characters
GATEWAY_SHARED_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=https://trace.example.com

# Safety: production always bootstraps READ_ONLY. PAPER promotion is explicit.
TRADING_MODE=READ_ONLY
LIVE_TRADING_ENABLED=false

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# PostgreSQL
POSTGRES_DB=sibyl
POSTGRES_USER=sibyl
POSTGRES_PASSWORD=change-me

# Encrypted R2 backups
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=sibyl-trace-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
BACKUP_ENCRYPTION_KEY=
