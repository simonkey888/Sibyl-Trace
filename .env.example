# Runtime
APP_ENV=production
APP_VERSION=dev
DATABASE_URL=postgresql+psycopg://sibyl:change-me@db:5432/sibyl
INITIAL_BANKROLL_USD=300
SCAN_INTERVAL_SECONDS=3600
WATCH_INTERVAL_SECONDS=5
CANDIDATE_LIMIT=20
TRACKED_WALLET_LIMIT=3
ADMIN_TOKEN=replace-with-32-random-bytes
GATEWAY_SHARED_SECRET=replace-with-32-random-bytes
CORS_ORIGINS=https://trace.example.com

# Safety: LIVE remains unavailable unless code and deployment are explicitly promoted.
TRADING_MODE=PAPER
LIVE_TRADING_ENABLED=false

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# PostgreSQL
POSTGRES_DB=sibyl
POSTGRES_USER=sibyl
POSTGRES_PASSWORD=change-me

# Encrypted R2 backups
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=sibyl-trace-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
BACKUP_ENCRYPTION_KEY=
